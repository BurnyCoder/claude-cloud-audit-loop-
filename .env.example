# Copy to .env (gitignored). Environment variables override these; flags override both.
AUDIT_BUDGET_USD=250            # total session spend to aim for, list-price USD
AUDIT_STOP_MARGIN_USD=12        # stop launching audits at budget - margin (running ones finish)
AUDIT_CAP_USD=6                 # default soft cap per audit; `audit-loop prompt --cap` overrides
AUDIT_REPOS_FILE=repos.txt      # one owner/name or GitHub URL per line, audited in this order
AUDIT_WORKDIR=workdir           # clones go here
AUDIT_REPORTS_DIR=reports       # ledger.jsonl, audits/<repo>/round-<n>.md, summary.md
AUDIT_BRANCH_PREFIX=fact-check  # audit branches are <prefix>/<YYYY-MM-DD>-r<round>
AUDIT_PROMPT_FILE=              # empty = bundled src/audit_loop/prompts/audit.md
AUDIT_COMMIT_TRAILER=           # lines appended to every audit commit; write \n between lines
AUDIT_PR_FOOTER=                # text appended to every PR description; write \n between lines
